<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>Assets\AudioMonitor.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\AudioMonitor.png" />
    <Content Include="Assets\AudioMonitor.ico">
      <Link>Assets\AudioMonitor.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\AudioMonitor.png">
      <Link>Assets\AudioMonitor.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="BuildNativeAudio" BeforeTargets="PrepareForBuild">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\..\native\AudioMonitor.Native.vcxproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=x64;PlatformToolset=v145;OutDir=$(MSBuildProjectDirectory)\..\..\native\build\$(Configuration)\;IntDir=$(MSBuildProjectDirectory)\..\..\native\obj\$(Configuration)\" />
  </Target>
  <Target Name="CopyNativeAudioLibrary" AfterTargets="Build">
    <PropertyGroup>
      <NativeAudioDll>$(MSBuildProjectDirectory)\..\..\native\build\$(Configuration)\AudioMonitor.Native.dll</NativeAudioDll>
    </PropertyGroup>
    <Error Condition="!Exists('$(NativeAudioDll)')" Text="Native WASAPI capture library was not produced: $(NativeAudioDll). Ensure the Visual Studio C++ workload and Windows SDK are installed." />
    <Copy SourceFiles="$(NativeAudioDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
